{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "blabber-app",
  "version": "0.0.5",
  "identifier": "com.robobeti.blabber-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "blabber-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["assets/sounds"],
    "createUpdaterArtifacts": true
  },
  "plugins" : {
    "updater" : {
      "pubkey" : "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0MDVBQjkwRDYzOEZDMApSV1RBajJNTnVWcEFCZWhjY2M0OHBaUVphUENUU0R5eUsvNmxYcHpjOS9ndlYrazA3VWNZUXdNTQo=",
      "endpoints" : [
        "https://updates.b3ni.net/latest.json"
      ]
    }
  }
}
